{
  "name": "Suporte - Consultar Dúvidas Frequentes (Chat IA)",
  "nodes": [
    {
      "id": "4b3f6b1f-3ee0-477e-8a62-49c9537dacd3",
      "name": "Pergunte Sobre as Dúvidas dos Clientes",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "5015822d-a91d-48ab-be21-7f2746d48a7b",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "03043eeb-d5a1-4fab-9466-9b8b453706b2",
      "name": "Buscar Mensagens de Clientes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        460,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT message_text, message_timestamp\nFROM support_messages\nWHERE is_support = FALSE\nORDER BY message_timestamp DESC\nLIMIT 500;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "SUBSTITUA_PELO_ID_DA_CREDENCIAL",
          "name": "Postgres - Hooked Sistemas"
        }
      }
    },
    {
      "id": "a34db14a-b29f-4567-9db8-6501c8b89dad",
      "name": "Formatar Mensagens para a IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map((i) => i.json);\n\nconst formatted = rows\n  .map((r, idx) => `${idx + 1}. [${new Date(r.message_timestamp).toLocaleString('pt-BR')}] ${r.message_text}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    formatted_messages: formatted || 'Nenhuma mensagem de cliente registrada ainda.',\n  },\n}];"
      }
    },
    {
      "id": "f9589eed-897e-4489-a8a3-2ce68e81e006",
      "name": "Agente de Perguntas Frequentes",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        900,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Pergunte Sobre as Dúvidas dos Clientes').item.json.chatInput }}",
        "options": {
          "systemMessage": "=Você é um assistente do suporte da Hooked Sistemas (sistema de ponto). Sua função é analisar as mensagens reais enviadas por clientes (listadas abaixo) e responder perguntas sobre quais são as dúvidas mais frequentes, como elas aparecem e sugerir uma resposta padrão para cada uma. Agrupe mensagens parecidas mesmo que estejam escritas de forma diferente, e diga aproximadamente quantas vezes cada tipo de dúvida apareceu.\n\nMensagens dos clientes (mais recentes primeiro):\n{{ $json.formatted_messages }}"
        }
      }
    },
    {
      "id": "12280bcf-f818-46ea-b546-707f523a035d",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        860,
        500
      ],
      "parameters": {
        "modelName": "models/gemini-2.0-flash"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "SUBSTITUA_PELO_ID_DA_CREDENCIAL",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "id": "b5624c4d-adb0-46f2-a738-ac6d2e8a520e",
      "name": "Memória da Conversa",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        1020,
        500
      ],
      "parameters": {}
    }
  ],
